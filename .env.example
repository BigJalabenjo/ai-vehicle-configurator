# Copy to .env and fill in. .env is git-ignored - never commit real keys.
# Set ONE of the API keys. With no key, the app runs in guided (offline) mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which LLM provider: auto (whichever key is set, OpenAI first) | openai | anthropic
LLM_PROVIDER=auto
# auto (LLM if a key is set, otherwise guided) | llm | offline
AGENT_MODE=auto
# Optional model override. Defaults: gpt-5.5 (OpenAI), claude-opus-5-5 (Anthropic)
LLM_MODEL=
# Optional reasoning effort (low | medium | high). Leave empty for non-reasoning models.
LLM_EFFORT=

# Password protection for a published app. Leave APP_PASSWORD empty to keep the app open (local use).
APP_PASSWORD=
# Random secret for signing session cookies, e.g. `openssl rand -hex 32`. Keeps sign-ins valid across restarts.
APP_SECRET=
# How long a sign-in lasts
AUTH_TTL_HOURS=12

# Sites allowed to show the app in an overlay (Chrome extension), space-separated. Empty = no embedding.
# Example (BMW configurator, used by the Chrome extension): EMBED_ORIGINS=https://configure.bmw.de
EMBED_ORIGINS=
