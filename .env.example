# Copy to .env and fill in. .env is git-ignored - never commit real keys.
# Set ONE of the API keys. With no key, the app runs in guided (offline) mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which LLM provider: auto (whichever key is set, OpenAI first) | openai | anthropic
LLM_PROVIDER=auto
# auto (LLM if a key is set, otherwise guided) | llm | offline
AGENT_MODE=auto
# Optional model override. Defaults: gpt-5.5 (OpenAI), claude-opus-5-5 (Anthropic)
LLM_MODEL=
# Optional reasoning effort (low | medium | high). Leave empty for non-reasoning models.
LLM_EFFORT=
