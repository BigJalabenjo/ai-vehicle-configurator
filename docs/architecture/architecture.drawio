<mxfile host="generate.py"><diagram name="Target architecture" id="arch"><mxGraphModel dx="1760" dy="1130" grid="1" gridSize="10" pageWidth="1760" pageHeight="1130"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="AI Vehicle Configurator – Target Architecture (AWS)" style="text;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="900" height="34" as="geometry"/></mxCell><mxCell id="g0" value="AWS Cloud · eu-central-1 (EU data residency)" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="1200" height="1000" as="geometry"/></mxCell><mxCell id="g1" value="Edge" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#8C4FFF;fontColor=#8C4FFF;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="215" y="360" width="220" height="240" as="geometry"/></mxCell><mxCell id="g2" value="Generative AI (managed)" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#01A88D;fontColor=#01A88D;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="740" y="130" width="620" height="135" as="geometry"/></mxCell><mxCell id="g3" value="VPC (private, 3 AZs)" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#00A4A6;fontColor=#00A4A6;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="715" y="300" width="650" height="630" as="geometry"/></mxCell><mxCell id="g4" value="Observability (all services)" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#3F8624;fontColor=#3F8624;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="215" y="965" width="1120" height="130" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Browser / mobile&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#232F3E;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="150" height="70" as="geometry"/></mxCell><mxCell id="cf" value="&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;+ AWS WAF &amp;amp; Shield, TLS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8C4FFF;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="390" width="190" height="70" as="geometry"/></mxCell><mxCell id="s3web" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Static web client (OAC)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAFC;strokeColor=#C925D1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="520" width="190" height="60" as="geometry"/></mxCell><mxCell id="apigw" value="&lt;b&gt;Amazon API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;HTTP API: auth, throttling,&lt;br&gt;request validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8C4FFF;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="390" width="200" height="76" as="geometry"/></mxCell><mxCell id="cognito" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Optional sign-in; anonymous&lt;br&gt;sessions via signed token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBEE;strokeColor=#DD344C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="560" width="200" height="76" as="geometry"/></mxCell><mxCell id="bedrock" value="&lt;b&gt;Amazon Bedrock · Claude&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Tool use via VPC endpoint,&lt;br&gt;in-region, no training on data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F7F4;strokeColor=#01A88D;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="170" width="270" height="76" as="geometry"/></mxCell><mxCell id="guard" value="&lt;b&gt;Bedrock Guardrails&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;PII redaction, denied topics,&lt;br&gt;prompt-attack filter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F7F4;strokeColor=#01A88D;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="175" width="260" height="66" as="geometry"/></mxCell><mxCell id="agent" value="&lt;b&gt;Agent Orchestrator&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;ECS Fargate · autoscaling&lt;br&gt;LLM tool loop, guardrails,&lt;br&gt;adaptive-UI composer, guided fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="740" y="360" width="260" height="106" as="geometry"/></mxCell><mxCell id="catalog" value="&lt;b&gt;Configuration &amp;amp; Catalog Service&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;ECS Fargate · autoscaling&lt;br&gt;rules engine, pricing,&lt;br&gt;recommendation &amp;amp; trade-offs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="360" width="260" height="106" as="geometry"/></mxCell><mxCell id="ddb" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Session state &amp;amp; conversation&lt;br&gt;(TTL, KMS-encrypted)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAFC;strokeColor=#C925D1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="740" y="560" width="260" height="70" as="geometry"/></mxCell><mxCell id="catstore" value="&lt;b&gt;Catalog &amp;amp; Rules Store&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Aurora PostgreSQL (versioned&lt;br&gt;catalog) + in-process cache&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAFC;strokeColor=#C925D1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="560" width="260" height="70" as="geometry"/></mxCell><mxCell id="bus" value="&lt;b&gt;Amazon EventBridge&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;configuration.completed&lt;br&gt;(only with customer consent)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8F2;strokeColor=#E7157B;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="740" y="700" width="260" height="70" as="geometry"/></mxCell><mxCell id="sync" value="&lt;b&gt;Catalog Sync&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;EventBridge Scheduler + Lambda:&lt;br&gt;validate &amp;amp; publish catalog version&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8F2;strokeColor=#E7157B;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="700" width="260" height="70" as="geometry"/></mxCell><mxCell id="secrets" value="&lt;b&gt;Secrets Manager · KMS · IAM&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;No keys in code; least-privilege&lt;br&gt;task roles; encryption at rest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBEE;strokeColor=#DD344C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="740" y="830" width="260" height="70" as="geometry"/></mxCell><mxCell id="pim" value="&lt;b&gt;Product / Pricing / Feasibility&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Existing enterprise systems&lt;br&gt;(PIM, price lists, buildability)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1430" y="690" width="290" height="76" as="geometry"/></mxCell><mxCell id="dealer" value="&lt;b&gt;Dealer / Order / CRM&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Lead hand-over, order entry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1430" y="850" width="290" height="70" as="geometry"/></mxCell><mxCell id="cw" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Logs, metrics, alarms,&lt;br&gt;dashboards&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF6E9;strokeColor=#3F8624;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="1000" width="230" height="70" as="geometry"/></mxCell><mxCell id="xray" value="&lt;b&gt;X-Ray / ADOT&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;OpenTelemetry traces across&lt;br&gt;web → agent → catalog → LLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF6E9;strokeColor=#3F8624;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="1000" width="250" height="70" as="geometry"/></mxCell><mxCell id="llmops" value="&lt;b&gt;LLM telemetry &amp;amp; evals&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Tokens, latency, tool errors,&lt;br&gt;fallback rate; offline eval set&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF6E9;strokeColor=#3F8624;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="1000" width="250" height="70" as="geometry"/></mxCell><mxCell id="lake" value="&lt;b&gt;S3 audit &amp;amp; analytics&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;PII-redacted transcripts,&lt;br&gt;conversion funnel (Athena)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF6E9;strokeColor=#3F8624;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1050" y="1000" width="250" height="70" as="geometry"/></mxCell><mxCell id="cicd" value="&lt;b&gt;CI/CD&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;GitHub Actions → ECR →&lt;br&gt;ECS blue/green deploys&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF6E9;strokeColor=#3F8624;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="830" width="160" height="70" as="geometry"/></mxCell><mxCell id="e0" value="① HTTPS" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="static assets" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cf" target="s3web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="② /api/*" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cf" target="apigw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="JWT (optional)" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="apigw" target="cognito"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="③ turn" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apigw" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="④ LLM + tools" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent" target="bedrock"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="bedrock" target="guard"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="⑤ tool calls" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent" target="catalog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="⑥ session state" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent" target="ddb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="catalog" target="catstore"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="⑦ publish" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync" target="catstore"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="pull / events" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pim" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="⑧ streams → pipes" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="ddb" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="hand-over" style="endArrow=block;endFill=1;html=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bus" target="dealer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Flow &amp;amp; key decisions&lt;/b&gt;&lt;br&gt;① SPA served via CloudFront from S3&lt;br&gt;② Same-origin API; WAF + throttling&lt;br&gt;③ Each turn is free text or a structured&lt;br&gt;   UI action (card click, toggle, slider)&lt;br&gt;④ Claude interprets needs, plans tool calls&lt;br&gt;   and chooses adaptive UI components&lt;br&gt;⑤ Prices, rules and compatibility only come&lt;br&gt;   from the deterministic engine; the agent&lt;br&gt;   never invents them (grounded UI)&lt;br&gt;⑥ Stateless containers scale out; state&lt;br&gt;   lives in DynamoDB with TTL&lt;br&gt;⑦ Catalog versions pass integrity checks&lt;br&gt;   before they are published&lt;br&gt;⑧ Hand-over only with consent&lt;br&gt;&lt;br&gt;Resilience: LLM timeout/outage → guided&lt;br&gt;rule-based mode; retries with backoff;&lt;br&gt;multi-AZ; health checks; autoscaling&lt;br&gt;Privacy: no PII in prompts or logs,&lt;br&gt;Guardrails PII filter, EU region&lt;br&gt;&lt;br&gt;Prototype mapping: nginx → CloudFront/S3;&lt;br&gt;agent &amp;amp; catalog containers → ECS;&lt;br&gt;in-memory sessions → DynamoDB;&lt;br&gt;Anthropic API → Bedrock" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1420" y="130" width="330" height="480" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>